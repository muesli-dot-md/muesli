{
  "name": "@muesli/workspace-setup",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./react": {
      "types": "./src/react/index.ts",
      "default": "./src/react/index.ts"
    },
    "./react/wizard-common": {
      "types": "./src/react/wizard-common.ts",
      "default": "./src/react/wizard-common.ts"
    },
    "./react/*": {
      "types": "./src/react/*.tsx",
      "default": "./src/react/*.tsx"
    },
    "./onboarding": {
      "types": "./src/onboarding.ts",
      "default": "./src/onboarding.ts"
    },
    "./sharepoint": {
      "types": "./src/sharepoint.ts",
      "default": "./src/sharepoint.ts"
    },
    "./host": {
      "types": "./src/host.ts",
      "default": "./src/host.ts"
    },
    "./capabilities": {
      "types": "./src/capabilities.ts",
      "default": "./src/capabilities.ts"
    },
    "./machine": {
      "types": "./src/machine.ts",
      "default": "./src/machine.ts"
    },
    "./copy": {
      "types": "./src/copy.ts",
      "default": "./src/copy.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "check": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "~5.7.0",
    "vitest": "^4.1.9"
  }
}
